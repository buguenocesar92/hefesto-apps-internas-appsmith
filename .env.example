# =============================================================================
# Hefesto Studio - Kit Appsmith Community Edition
# Archivo    : .env.example
# Uso        : cp .env.example .env   y luego reemplazar cada VALOR_POR_CAMBAR.
# IMPORTANTE : este archivo NO tiene secretos. .env NUNCA se sube al
#              repositorio ni se manda por correo. Ver .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) OBLIGATORIAS - sin estas el `docker compose up` falla a proposito
# -----------------------------------------------------------------------------
# Son la clave con la que Appsmith cifra las credenciales de tus fuentes de
# datos (PostgreSQL, MySQL, API). Si las pierdes, las credenciales ya guardadas
# quedan indescifrables y habria que volver a ingresarlas a mano.
#
# La imagen genera valores si faltan, pero quedan escritos dentro del volumen
# en /appsmith-stacks/configuration/docker.env. Fijarlos tu aqui y respaldar
# ese archivo es la forma de tenerlos bajo control.
#
# GENERAR: openssl rand -hex 32
# -----------------------------------------------------------------------------

# OBLIGATORIA. Clave de cifrado de secretos de Appsmith.
APPSMITH_ENCRYPTION_PASSWORD=VALOR_POR_CAMBAR_genera_con_openssl_rand_hex_32

# OBLIGATORIA. Sal asociada a la clave de cifrado.
APPSMITH_ENCRYPTION_SALT=VALOR_POR_CAMBAR_genera_con_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# 2) URL publica - necesarias para que funcionen las acciones de cuenta
# -----------------------------------------------------------------------------
# Appsmith valida el header Origin contra esta lista. Sin esto, el reinicio de
# clave y la verificacion de correo fallan o se pueden explotar.
# Formato: https://apps.ejemplo.cl  (con esquema, sin barra final)
# -----------------------------------------------------------------------------

# Recomendada. Sin esquema, solo el host (apps.ejemplo.cl). Si se define, el
# Caddy interno intenta emitir su propio certificado Let's Encrypt en el puerto
# 443. Detras de Coolify o de un reverse proxy NO se debe usar.
APPSMITH_CUSTOM_DOMAIN=

# Recomendada. Lista de URLs publicas permitidas, separadas por comas.
# Debe incluir la URL por la que realmente se entra.
APPSMITH_BASE_URL=https://apps.ejemplo.cl

# -----------------------------------------------------------------------------
# 3) Administradores y registro
# -----------------------------------------------------------------------------
# Correos que tendran permisos de Instance Administrator.
# ATENCION: la variable es en plural y NO existe una variable para fijar la
# contrasena del administrador. El primer administrador se crea mediante el
# formulario web en /signup (ver docs/04-PRIMERA-CUENTA-Y-USUARIOS.md).
# Deben ser correos reales de la empresa: ese es el unico control de que la
# persona que se registra es del equipo.
APPSMITH_ADMIN_EMAILS=admin@ejemplo.cl

# true = no se pueden crear cuentas nuevas. Recomendado en produccion.
# Los usuarios ya existentes siguen entrando con normalidad.
APPSMITH_SIGNUP_DISABLED=true

# Opcional. Lista de dominio permitidos para registrarse, separada por comas.
# Requiere ademas APPSMITH_SIGNUP_DISABLED=false.
APPSMITH_SIGNUP_ALLOWED_DOMAINS=

# -----------------------------------------------------------------------------
# 4) Limites y proteccion
# -----------------------------------------------------------------------------
# Peticiones por segundo y por cliente. Vacio = 100 (valor por defecto de Appsmith).
APPSMITH_RATE_LIMIT=

# Dominios autorizados a embeber Appsmith en un iframe.
# "'self'" = solo el mismo origen. Es la opcion recomendada.
# Vacio = solo las peticiones del mismo origen.
APPSMITH_ALLOWED_FRAME_ANCESTORS=

# -----------------------------------------------------------------------------
# 5) Privacidad
# -----------------------------------------------------------------------------
# true = Appsmith no recibe telemetria anonimizada de uso.
# APPSMITH_DISABLE_TELEMETRY=true
#
# true = se quita el widget de Intercom de las instancias autoalojadas.
# APPSMITH_DISABLE_INTERCOM=true

# -----------------------------------------------------------------------------
# 6) Ajustes de archivos y tiempos
# -----------------------------------------------------------------------------
# Limite de archivo adjunto en MB. Vacio = 200 (por defecto de Appsmith).
APPSMITH_CODEC_SIZE=

# Timeout interno del servidor en segundos. Vacio = 60 (por defecto).
APPSMITH_SERVER_TIMEOUT=

# -----------------------------------------------------------------------------
# 7) Correo (SMTP) - OJO, ver la nota de abajo
# -----------------------------------------------------------------------------
# La documentacion oficial usa los nombres APPSMITH_EMAIL_*, pero la plantilla
# que se escribe dentro de la imagen al primer arranque sigue generando los
# nombres antiguos APPSMITH_MAIL_*. Esa diferencia no fue aclarada por Hefesto
# con el proveedor, asi que la RECOMENDACION para una Pyme es configurar el
# correo desde la interfaz: Admin Settings > Settings > General > SMTP.
#
# Recordatorio importante: las variables de entorno tienen prioridad sobre lo
# guardado en Admin Settings. Si defines aca una variable mal escrita, la
# interfaz NO la va a poder corregir.
#
# Correo saliente (envio de invitaciones, reinicio de clave):
# APPSMITH_EMAIL_ENABLED=true
# APPSMITH_EMAIL_SERVER_HOST=smtp.ejemplo.cl
# APPSMITH_EMAIL_SERVER_PORT=587
# APPSMITH_EMAIL_SERVER_USERNAME=
# APPSMITH_EMAIL_SERVER_PASSWORD=
# APPSMITH_EMAIL_SERVER_TLS=true
#
# Remitente:
# APPSMITH_EMAIL_FROM=apps@ejemplo.cl
#
# Nombres alternativos (plantilla de la imagen):
# APPSMITH_MAIL_ENABLED=true
# APPSMITH_MAIL_HOST=smtp.ejemplo.cl
# APPSMITH_MAIL_PORT=587
# APPSMITH_MAIL_USERNAME=
# APPSMITH_MAIL_PASSWORD=
# APPSMITH_MAIL_SSL=true
# APPSMITH_REPLY_TO=apps@ejemplo.cl
#
# Correo entrante (respuestas a las notificaciones de apps):
# APPSMITH_MAIL_INBOUND_DOMAIN=apps.ejemplo.cl
# APPSMITH_MAIL_INBOUND_SECRET=
#
# -----------------------------------------------------------------------------
# 8) Integracion con Git (opcional)
# -----------------------------------------------------------------------------
# Debe quedar DENTRO del volumen persistente o los repos se pierden al
# reiniciar. Ver docs/05.
# APPSMITH_GIT_ROOT=/appsmith-stacks/data/git

# -----------------------------------------------------------------------------
# 9) Solo Coolify
# -----------------------------------------------------------------------------
# Usado por config/compose.coolify.yaml. Ver docs/02-INSTALACION-COOLIFY.md.
# COOLIFY_RESOURCE_NAME=apps-internas